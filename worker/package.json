{
  "name": "classpoints-api",
  "version": "1.0.0",
  "private": true,
  "description": "班级积分系统同步中枢：Cloudflare Worker + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply classpoints --local",
    "migrate:remote": "wrangler d1 migrations apply classpoints --remote",
    "db:reset": "node scripts/reset-local-db.mjs",
    "test:smoke": "node test/smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.86.0"
  }
}
