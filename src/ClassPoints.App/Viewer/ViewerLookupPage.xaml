<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassPoints.App.Viewer.ViewerLookupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16,12,16,16" ColumnSpacing="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== 左：找人 ===== -->
        <Border Style="{StaticResource DeskCardBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Padding="14,12" Spacing="8">
                    <TextBox x:Name="SearchBox" PlaceholderText="输入姓名或座位号" Height="36"
                             TextChanged="OnSearchChanged" />
                    <TextBlock x:Name="CountText" Style="{StaticResource DeskSecondaryText}" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="StudentList" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ===== 右：档案 ===== -->
        <Border Grid.Column="1" Style="{StaticResource DeskCardBorder}">
            <Grid>
                <StackPanel x:Name="Hint" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                    <TextBlock Text="选一个学生" Style="{StaticResource DeskH2Text}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="左边列表里点名字，或者直接在上面搜。"
                               Style="{StaticResource DeskSecondaryText}" />
                </StackPanel>

                <ScrollViewer x:Name="DetailScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="NameText" Style="{StaticResource DeskH1Text}" FontSize="30" />
                            <TextBlock x:Name="SubText" Style="{StaticResource DeskSecondaryText}" />
                        </StackPanel>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{ThemeResource TileBgBrush}" CornerRadius="8"
                                    Padding="14,10">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="PeriodPoints" Text="0"
                                               FontFamily="{StaticResource NumberFont}" FontSize="28"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="本周期积分" Style="{StaticResource DeskSecondaryText}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{ThemeResource TileBgBrush}" CornerRadius="8"
                                    Padding="14,10">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="TermPoints" Text="0"
                                               FontFamily="{StaticResource NumberFont}" FontSize="28"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="学期累计" Style="{StaticResource DeskSecondaryText}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{ThemeResource TileBgBrush}" CornerRadius="8"
                                    Padding="14,10">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="EventText" Text="0"
                                               FontFamily="{StaticResource NumberFont}" FontSize="28"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="本周期事件" Style="{StaticResource DeskSecondaryText}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock Text="事件明细" Style="{StaticResource DeskH2Text}" />
                            <StackPanel x:Name="EventList" Orientation="Horizontal" Spacing="8" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="积分明细" Style="{StaticResource DeskH2Text}" />
                            <StackPanel x:Name="EntryList" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
