<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassPoints.App.Viewer.ViewerCountersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16,12,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Spacing="2">
                <TextBlock Text="事件统计" Style="{StaticResource DeskH1Text}" FontSize="24" />
                <TextBlock x:Name="SubText" Style="{StaticResource DeskSecondaryText}" />
            </StackPanel>

            <TextBox x:Name="SearchBox" PlaceholderText="搜索姓名" Height="34" Width="200"
                     HorizontalAlignment="Right" VerticalAlignment="Center" TextChanged="OnSearchChanged" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource DeskCardBorder}" Padding="0" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="{ThemeResource TileBgBrush}" CornerRadius="10,10,0,0" Padding="14,10">
                    <Grid x:Name="HeaderHost" ColumnSpacing="10" />
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="RowList" />
                </ScrollViewer>

                <TextBlock x:Name="EmptyText" Grid.Row="1" Text="本周期还没有事件记录。"
                           Style="{StaticResource DeskSecondaryText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Page>
