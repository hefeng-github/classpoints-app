<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ClassPoints.App.Controls.HoldButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">

    <!-- 危险操作：长按 3 秒，有进度环，中途松手取消。不用普通点击。 -->
    <Border x:Name="Root"
            Background="{ThemeResource NegativeBgBrush}"
            BorderBrush="{ThemeResource DangerBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="20,0"
            Height="64"
            MinWidth="180">
        <Grid>
            <TextBlock x:Name="LabelText"
                       Text="长按确认"
                       FontFamily="{StaticResource TextFont}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource DangerBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            <ProgressBar x:Name="Progress"
                         VerticalAlignment="Bottom"
                         Height="6"
                         Minimum="0"
                         Maximum="1"
                         Value="0"
                         Foreground="{ThemeResource DangerBrush}"
                         Background="Transparent"
                         Margin="-20,0,-20,-4" />
        </Grid>
    </Border>
</UserControl>
