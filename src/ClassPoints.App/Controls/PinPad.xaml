<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ClassPoints.App.Controls.PinPad"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False"
    Visibility="Collapsed">

    <Grid>
        <Rectangle Fill="{ThemeResource ScrimBrush}" Tapped="OnScrimTapped" />

        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="420"
                Background="{ThemeResource CardBgBrush}"
                BorderBrush="{ThemeResource CardStrokeBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="24">
            <StackPanel Spacing="14">
                <TextBlock x:Name="TitleText" Text="管理模式密码" Style="{StaticResource H2Text}"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="SubText" Text="输入 6 位数字" Style="{StaticResource SecondaryText}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />

                <!-- 六个点 -->
                <StackPanel x:Name="DotsPanel" Orientation="Horizontal" Spacing="14"
                            HorizontalAlignment="Center" Margin="0,4,0,4" />

                <Grid ColumnSpacing="12" RowSpacing="12" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{StaticResource TouchKeyButton}" Click="OnDigitClick" Tag="1" />
                    <Button Grid.Row="0" Grid.Column="1" Content="2" Style="{StaticResource TouchKeyButton}" Click="OnDigitClick" Tag="2" />
                    <Button Grid.Row="0" Grid.Column="2" Content="3" Style="{StaticResource TouchKeyButton}" Click="OnDigitClick" Tag="3" />
                    <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource TouchKeyButton}" Click="OnDigitClick" Tag="4" />
                    <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource TouchKeyButton}" Click="OnDigitClick" Tag="5" />
                    <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource TouchKeyButton}" Click="OnDigitClick" Tag="6" />
                    <Button Grid.Row="2" Grid.Column="0" Content="7" Style="{StaticResource TouchKeyButton}" Click="OnDigitClick" Tag="7" />
                    <Button Grid.Row="2" Grid.Column="1" Content="8" Style="{StaticResource TouchKeyButton}" Click="OnDigitClick" Tag="8" />
                    <Button Grid.Row="2" Grid.Column="2" Content="9" Style="{StaticResource TouchKeyButton}" Click="OnDigitClick" Tag="9" />
                    <Button Grid.Row="3" Grid.Column="0" Content="取消" Style="{StaticResource TouchKeyButton}"
                            FontFamily="{StaticResource TextFont}" FontSize="16" Click="OnCancelClick" />
                    <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{StaticResource TouchKeyButton}" Click="OnDigitClick" Tag="0" />
                    <Button Grid.Row="3" Grid.Column="2" Content="⌫" Style="{StaticResource TouchKeyButton}" Click="OnBackspaceClick" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
