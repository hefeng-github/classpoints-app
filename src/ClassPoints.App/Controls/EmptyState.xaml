<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ClassPoints.App.Controls.EmptyState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False"
    Visibility="Collapsed">

    <!-- 空状态的文案要说下一步做什么，不是陈述"暂无数据"。前者是引导，后者是死路。 -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="620">
        <FontIcon x:Name="GlyphIcon"
                  Glyph="&#xE7B8;"
                  FontSize="56"
                  Foreground="{ThemeResource TextSecondaryBrush}"
                  HorizontalAlignment="Center" />
        <TextBlock x:Name="MessageText"
                   Style="{StaticResource BodyText}"
                   Foreground="{ThemeResource TextSecondaryBrush}"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
            <Button x:Name="PrimaryButton"
                    Style="{StaticResource TouchSecondaryButton}"
                    Height="52"
                    Click="OnPrimaryClick" />
            <Button x:Name="SecondaryButton"
                    Style="{StaticResource TouchSecondaryButton}"
                    Height="52"
                    Visibility="Collapsed"
                    Click="OnSecondaryClick" />
        </StackPanel>
    </StackPanel>
</UserControl>
