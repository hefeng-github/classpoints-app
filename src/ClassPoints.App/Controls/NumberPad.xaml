<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ClassPoints.App.Controls.NumberPad"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False"
    Visibility="Collapsed">

    <Grid>
        <!-- 遮罩：挡住下面卡片的点击，但卡片仍然可见（老师能继续对着学生核对） -->
        <Rectangle Fill="{ThemeResource ScrimBrush}" Tapped="OnScrimTapped" />

        <Border VerticalAlignment="Bottom"
                Background="{ThemeResource CardBgBrush}"
                BorderBrush="{ThemeResource CardStrokeBrush}"
                BorderThickness="1,1,1,0"
                CornerRadius="16,16,0,0"
                Padding="20,14,20,16">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题行 -->
                <Grid Grid.Row="0">
                    <TextBlock x:Name="TitleText" Style="{StaticResource H2Text}" VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right" Width="44" Height="44"
                            Style="{StaticResource TouchSecondaryButton}" MinWidth="44"
                            Click="OnCancelClick">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                    </Button>
                </Grid>

                <!-- 理由标签：贴在数字上方，手指在动视线也在动，不能放到面板顶部 -->
                <StackPanel Grid.Row="1" Spacing="6">
                    <TextBlock Text="理由（可选，最多两个）" Style="{StaticResource SecondaryText}" />
                    <StackPanel x:Name="TagPanel" Orientation="Horizontal" Spacing="8" />
                </StackPanel>

                <!-- 数字显示 -->
                <Grid Grid.Row="2" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="ValueText" Text="+50"
                                   FontFamily="{StaticResource NumberFont}" FontSize="56" FontWeight="Bold"
                                   Foreground="{ThemeResource TextPrimaryBrush}" TextLineBounds="Tight" />
                        <TextBlock x:Name="HintText" Style="{StaticResource SmallText}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock x:Name="ScopeText" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right" />
                        <Button x:Name="OverCapButton" Content="按原值计入" Visibility="Collapsed"
                                Style="{StaticResource TouchSecondaryButton}" Height="44" MinWidth="120"
                                Click="OnOverCapClick" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>

                <!-- 键盘：3 列 × 4 行 -->
                <Grid Grid.Row="3" ColumnSpacing="10" RowSpacing="10" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{StaticResource TouchKeyButton}" Click="OnDigitClick" Tag="1" />
                    <Button Grid.Row="0" Grid.Column="1" Content="2" Style="{StaticResource TouchKeyButton}" Click="OnDigitClick" Tag="2" />
                    <Button Grid.Row="0" Grid.Column="2" Content="3" Style="{StaticResource TouchKeyButton}" Click="OnDigitClick" Tag="3" />
                    <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource TouchKeyButton}" Click="OnDigitClick" Tag="4" />
                    <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource TouchKeyButton}" Click="OnDigitClick" Tag="5" />
                    <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource TouchKeyButton}" Click="OnDigitClick" Tag="6" />
                    <Button Grid.Row="2" Grid.Column="0" Content="7" Style="{StaticResource TouchKeyButton}" Click="OnDigitClick" Tag="7" />
                    <Button Grid.Row="2" Grid.Column="1" Content="8" Style="{StaticResource TouchKeyButton}" Click="OnDigitClick" Tag="8" />
                    <Button Grid.Row="2" Grid.Column="2" Content="9" Style="{StaticResource TouchKeyButton}" Click="OnDigitClick" Tag="9" />
                    <Button Grid.Row="3" Grid.Column="0" Content="±" Style="{StaticResource TouchKeyButton}" Click="OnSignClick" />
                    <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{StaticResource TouchKeyButton}" Click="OnDigitClick" Tag="0" />
                    <Button Grid.Row="3" Grid.Column="2" Content="⌫" Style="{StaticResource TouchKeyButton}" Click="OnBackspaceClick" />
                </Grid>

                <!-- 确认：显示最终结果，不是光写「确定」 -->
                <Button x:Name="ConfirmButton"
                        Grid.Row="4"
                        Content="确定"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource TouchPrimaryButton}"
                        Height="64"
                        Click="OnConfirmClick" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
