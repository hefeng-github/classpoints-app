<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassPoints.App.Board.BoardWallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource BoardBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：只放信息，不放按钮 -->
        <Grid Grid.Row="0" Padding="28,22,28,10">
            <StackPanel>
                <TextBlock x:Name="ClassText" Style="{StaticResource H1Text}" />
                <TextBlock x:Name="PeriodText" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <!-- 时钟归外壳顶部的常驻状态条管，这里只留"现在放的是哪种榜"，免得一屏两个时间 -->
                <TextBlock x:Name="BoardModeText" Text="个人榜"
                           FontFamily="{StaticResource TextFont}" FontSize="20"
                           Foreground="{ThemeResource SelectStrokeBrush}"
                           HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="28,0,28,0" ColumnSpacing="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- 榜单 -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="18,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,0,4,8">
                        <TextBlock x:Name="ListHeader" Text="积分榜" Style="{StaticResource H2Text}" />
                        <TextBlock x:Name="ListSub" Style="{StaticResource SmallText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" ZoomMode="Disabled">
                        <StackPanel x:Name="RankPanel" Spacing="2" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 最近动态 -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="18,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="最近动态" Style="{StaticResource H2Text}" Margin="4,0,0,8" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" ZoomMode="Disabled">
                        <StackPanel x:Name="FeedPanel" Spacing="6" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部一行小字：常驻界面不显示任何按钮，避免围观时手贱乱点 -->
        <TextBlock Grid.Row="2" x:Name="HintText"
                   Text="轻触屏幕 · 或直接刷卡"
                   Style="{StaticResource SecondaryText}"
                   HorizontalAlignment="Center" Margin="0,10,0,14" />

        <!-- 轻触后的两个出口 -->
        <Grid x:Name="ActionLayer" Grid.RowSpan="3" Visibility="Collapsed">
            <Rectangle Fill="{ThemeResource ScrimBrush}" Tapped="OnScrimTapped" />
            <StackPanel Orientation="Horizontal" Spacing="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Width="300" Height="132" CornerRadius="16"
                        Background="{ThemeResource CardBgBrush}"
                        BorderBrush="{ThemeResource SelectStrokeBrush}"
                        BorderThickness="2"
                        Click="OnLookupClick">
                    <StackPanel Spacing="6">
                        <FontIcon Glyph="&#xE721;" FontSize="34" Foreground="{ThemeResource SelectStrokeBrush}" />
                        <TextBlock Text="查 分" FontSize="28" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="直接进" Style="{StaticResource SmallText}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Width="300" Height="132" CornerRadius="16"
                        Background="{ThemeResource CardBgBrush}"
                        BorderBrush="{ThemeResource CardStrokeBrush}"
                        BorderThickness="2"
                        Click="OnStartClick">
                    <StackPanel Spacing="6">
                        <FontIcon Glyph="&#xE8D7;" FontSize="34" Foreground="{ThemeResource PositiveBrush}" />
                        <TextBlock Text="开始记录" FontSize="28" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="刷卡或密码" Style="{StaticResource SmallText}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="EmptyText" Grid.Row="1" Text="还没有学生。到电脑端导入名单。"
                   Style="{StaticResource BodyText}" Foreground="{ThemeResource TextSecondaryBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                   TextAlignment="Center" MaxWidth="600" Visibility="Collapsed" />
    </Grid>
</Page>
