<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassPoints.App.Board.BoardCountersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ClassPoints.App.Controls"
    Background="{ThemeResource BoardBgBrush}">

    <Grid Padding="14,12,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 标题与总览 ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Spacing="2">
                <TextBlock Text="事件计数" Style="{StaticResource H2Text}" />
                <TextBlock x:Name="SubText" Style="{StaticResource SecondaryText}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <TextBlock x:Name="TotalText" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                <Button x:Name="UndoButton" Content="撤销上一步" Style="{StaticResource TouchSecondaryButton}"
                        Height="48" MinWidth="140" Click="OnUndoLast" IsEnabled="False" />
            </StackPanel>
        </Grid>

        <!-- ===== 事件选择 ===== -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled"
                      VerticalScrollMode="Disabled" ZoomMode="Disabled" Margin="0,0,0,10">
            <StackPanel x:Name="CounterPanel" Orientation="Horizontal" Spacing="10" />
        </ScrollViewer>

        <!-- ===== 学生卡片 ===== -->
        <Grid Grid.Row="2">
            <ScrollViewer x:Name="Scroll" ZoomMode="Disabled" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="CardGrid" HorizontalAlignment="Stretch" VerticalAlignment="Top" Background="Transparent" />
            </ScrollViewer>

            <controls:EmptyState x:Name="Empty" />
        </Grid>

        <controls:Toast x:Name="ToastLayer" />
    </Grid>
</Page>
