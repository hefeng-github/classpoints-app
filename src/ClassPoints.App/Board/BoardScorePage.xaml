<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassPoints.App.Board.BoardScorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ClassPoints.App.Controls"
    Background="{ThemeResource BoardBgBrush}">

    <Grid x:Name="Host">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 状态条 56：只放本页状态（班级名、同步、日期时钟都在外壳顶部那条上） ===== -->
        <Grid Grid.Row="0" Padding="12,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Name="WhoText" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="SelectedText" Text="已选 0 人"
                           FontFamily="{StaticResource NumberFont}" FontSize="20"
                           Foreground="{ThemeResource SelectStrokeBrush}" />
                <TextBlock x:Name="PreviewText" Text="" Style="{StaticResource SecondaryText}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="IdentityButton" Content="切换身份" Style="{StaticResource TouchSecondaryButton}"
                        Height="40" MinWidth="120" Click="OnIdentityClick" />
            </StackPanel>
        </Grid>

        <!-- ===== 卡片网格 ===== -->
        <Grid Grid.Row="1" Margin="12,0,12,0">
            <ScrollViewer x:Name="Scroll" ZoomMode="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Auto">
                <Grid x:Name="CardGrid" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                      Background="Transparent" />
            </ScrollViewer>

            <Canvas x:Name="LassoCanvas" IsHitTestVisible="False">
                <Rectangle x:Name="LassoRect" Visibility="Collapsed"
                           Stroke="{ThemeResource SelectStrokeBrush}" StrokeThickness="2"
                           Fill="{ThemeResource AccentTintBrush}" RadiusX="6" RadiusY="6" />
            </Canvas>

            <controls:EmptyState x:Name="Empty" />

            <Border x:Name="LassoBadge" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="{ThemeResource FloatingBgBrush}" BorderBrush="{ThemeResource SelectStrokeBrush}" BorderThickness="2"
                    CornerRadius="14" Padding="12,6" Margin="8">
                <TextBlock Text="框选中 · 抬手确认" Style="{StaticResource SecondaryText}" />
            </Border>
        </Grid>

        <!-- ===== 底部操作区 ===== -->
        <Grid Grid.Row="2" Padding="12,8,12,12" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Hidden"
                          HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" ZoomMode="Disabled">
                <StackPanel x:Name="RulePanel" Orientation="Horizontal" Spacing="10" />
            </ScrollViewer>

            <Grid Grid.Row="1">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
                    <Button x:Name="LassoButton" Content="框选" Style="{StaticResource TouchSecondaryButton}"
                            MinWidth="110" Click="OnLassoButtonClick" />
                    <Button x:Name="UndoLastButton" Content="撤销上一步" Style="{StaticResource TouchSecondaryButton}"
                            MinWidth="150" Click="OnUndoLastClick" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button x:Name="SelectAllButton" Content="全选本屏" Style="{StaticResource TouchSecondaryButton}"
                            MinWidth="120" Click="OnSelectAllClick" />
                    <Button x:Name="ClearButton" Content="清空" Style="{StaticResource TouchSecondaryButton}"
                            MinWidth="100" Click="OnClearClick" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ===== 入账确认条 / 撤销条：共用底部这一条位置，不同时出现 ===== -->
        <Grid Grid.Row="2" VerticalAlignment="Bottom" Height="88" x:Name="BarHost" Visibility="Collapsed">
            <Border Background="{ThemeResource FloatingBgBrush}" BorderBrush="{ThemeResource CardStrokeBrush}"
                    BorderThickness="1,1,1,0" CornerRadius="14,14,0,0" Padding="16,0">
                <Grid>
                    <TextBlock x:Name="BarText" Style="{StaticResource BodyText}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BarAuxButton" Content="备注" Style="{StaticResource TouchSecondaryButton}"
                                Height="60" MinWidth="110" Visibility="Collapsed" Click="OnBarAuxClick" />
                        <Button x:Name="BarCancelButton" Content="取消" Style="{StaticResource TouchSecondaryButton}"
                                Height="60" MinWidth="110" Click="OnBarCancelClick" />
                        <Button x:Name="BarOkButton" Content="确定" Style="{StaticResource TouchPrimaryButton}"
                                Height="60" MinWidth="220" Click="OnBarOkClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <controls:NumberPad x:Name="Pad" Grid.RowSpan="3" />
        <controls:Toast x:Name="ToastLayer" Grid.RowSpan="3" />

        <!-- ===== 学生档案 ===== -->
        <Grid x:Name="ProfileLayer" Grid.RowSpan="3" Visibility="Collapsed" Background="{ThemeResource ScrimBrush}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="720" MaxHeight="760"
                    Background="{ThemeResource CardBgBrush}" BorderBrush="{ThemeResource CardStrokeBrush}"
                    BorderThickness="1" CornerRadius="18" Padding="26">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock x:Name="ProfileName" Style="{StaticResource H1Text}" />
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                Style="{StaticResource TouchSecondaryButton}" Width="48" Height="48" MinWidth="48"
                                Click="OnProfileCloseClick">
                            <FontIcon Glyph="&#xE711;" FontSize="15" />
                        </Button>
                    </Grid>
                    <TextBlock x:Name="ProfileSub" Grid.Row="1" Style="{StaticResource SecondaryText}" />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ProfileList" Spacing="8" />
                    </ScrollViewer>

                    <TextBlock Grid.Row="3" Style="{StaticResource SmallText}" TextWrapping="Wrap"
                               Text="备注和操作人只在这里显示，查分页不显示。" />
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 补标签（入账后 5 秒内） ===== -->
        <Grid x:Name="NoteLayer" Grid.RowSpan="3" Visibility="Collapsed" Background="{ThemeResource ScrimBrush}">
            <Border VerticalAlignment="Bottom" Background="{ThemeResource CardBgBrush}"
                    BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1,1,1,0"
                    CornerRadius="16,16,0,0" Padding="20,16">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="给这一批补个理由（可选）" Style="{StaticResource H2Text}" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource TouchSecondaryButton}"
                                Width="44" Height="44" MinWidth="44" Click="OnNoteCloseClick">
                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                        </Button>
                    </Grid>
                    <StackPanel x:Name="NotePanel" Orientation="Horizontal" Spacing="8" />
                    <Button Content="完成" Style="{StaticResource TouchPrimaryButton}" Height="60"
                            HorizontalAlignment="Stretch" Click="OnNoteDoneClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
