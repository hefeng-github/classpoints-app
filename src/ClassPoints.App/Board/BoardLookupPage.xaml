<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassPoints.App.Board.BoardLookupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource BoardBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="12,0">
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <TextBlock Text="查分" Style="{StaticResource H2Text}" />
                <TextBlock Text="点一下自己的名字" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="PeriodText" Style="{StaticResource SecondaryText}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" Margin="12,0">
            <ScrollViewer x:Name="Scroll" ZoomMode="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="SeatGrid" Background="Transparent" VerticalAlignment="Top" />
            </ScrollViewer>

            <TextBlock x:Name="EmptyText" Text="名单还没建好，找班主任。"
                       Style="{StaticResource BodyText}" Foreground="{ThemeResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>

        <TextBlock Grid.Row="2" x:Name="HintText" Text="30 秒不操作会自动退出"
                   Style="{StaticResource SmallText}" HorizontalAlignment="Center" Margin="0,10,0,14" />

        <!-- 个人页：整窗覆盖，退出时清屏 -->
        <Grid x:Name="PersonalLayer" Grid.RowSpan="3" Visibility="Collapsed"
              Background="{ThemeResource BoardBgBrush}" Padding="28,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock x:Name="PersonName" Style="{StaticResource H1Text}" />
                    <TextBlock x:Name="PersonSeat" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                        Style="{StaticResource TouchSecondaryButton}" Width="56" Height="56" MinWidth="56"
                        Click="OnPersonalCloseClick">
                    <FontIcon Glyph="&#xE711;" FontSize="16" />
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="0,10,0,0" ColumnSpacing="36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="BigPoints" Text="0"
                               FontFamily="{StaticResource NumberFont}" FontSize="88" FontWeight="Bold"
                               Foreground="{ThemeResource TextPrimaryBrush}" TextLineBounds="Tight" />
                    <TextBlock x:Name="BigPointsLabel" Style="{StaticResource SecondaryText}" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                    <TextBlock x:Name="RankLine" Style="{StaticResource BodyText}" />
                    <TextBlock x:Name="GapLine" Style="{StaticResource SecondaryText}" />
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                        <ToggleButton x:Name="WeekToggle" Content="本周" Style="{StaticResource BoardTabButton}"
                                      Click="OnRangeToggle" Tag="week" />
                        <ToggleButton x:Name="PeriodToggle" Content="本周期" Style="{StaticResource BoardTabButton}"
                                      Click="OnRangeToggle" Tag="period" IsChecked="True" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="0,14,0,0" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="16,10">
                    <StackPanel>
                        <TextBlock x:Name="DistTitle" Text="我的加分" Style="{StaticResource H2Text}" Margin="2,0,0,6" />
                        <StackPanel x:Name="DistPanel" Spacing="6" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="16,10">
                    <StackPanel>
                        <TextBlock Text="最近记录" Style="{StaticResource H2Text}" Margin="2,0,0,6" />
                        <StackPanel x:Name="RecentPanel" Spacing="8" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
