<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassPoints.App.Desk.DeskStudentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="名单" Style="{StaticResource DeskH1Text}" />
            <TextBlock x:Name="SubText" Style="{StaticResource DeskSecondaryText}" />
        </StackPanel>

        <!-- ===== 工具条 ===== -->
        <Grid Grid.Row="1" Margin="0,16,0,12" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox" PlaceholderText="搜索姓名 / 学号" Height="34"
                     TextChanged="OnSearchChanged" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="粘贴一列姓名" Style="{StaticResource DeskButton}" Click="OnPasteNames" />
                <Button Content="从 Excel 导入" Style="{StaticResource DeskButton}" Click="OnImportExcel" />
                <Button Content="新增学生" Style="{StaticResource DeskPrimaryButton}" Click="OnAddStudent" />
                <Button Content="座位布局" Style="{StaticResource DeskButton}" Click="OnSeatLayout" />
                <Button Content="回收站" Style="{StaticResource DeskButton}" Click="OnRecycle" />
            </StackPanel>
        </Grid>

        <!-- ===== 表头 ===== -->
        <Border Grid.Row="2" Background="{ThemeResource CardBgBrush}" CornerRadius="8,8,0,0" Padding="12,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="学号" Style="{StaticResource DeskColumnHeader}" />
                <TextBlock Grid.Column="1" Text="姓名" Style="{StaticResource DeskColumnHeader}" />
                <TextBlock Grid.Column="2" Text="座位" Style="{StaticResource DeskColumnHeader}" />
                <TextBlock Grid.Column="3" Text="分组" Style="{StaticResource DeskColumnHeader}" />
                <TextBlock Grid.Column="4" Text="本月积分" Style="{StaticResource DeskColumnHeader}"
                           HorizontalAlignment="Right" />
                <TextBlock Grid.Column="5" Text="学期累计" Style="{StaticResource DeskColumnHeader}"
                           HorizontalAlignment="Right" />
                <TextBlock Grid.Column="6" Text="状态" Style="{StaticResource DeskColumnHeader}" />
                <TextBlock Grid.Column="7" Text="操作" Style="{StaticResource DeskColumnHeader}" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource DeskCardBorder}" CornerRadius="0,0,8,8" Padding="0">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="RowList" />
                </ScrollViewer>

                <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Spacing="10" Visibility="Collapsed">
                    <TextBlock Text="名单还是空的" Style="{StaticResource DeskH2Text}" HorizontalAlignment="Center" />
                    <TextBlock Text="粘贴一列姓名最快。也可以从 Excel 导入学号和座位。"
                               Style="{StaticResource DeskSecondaryText}" HorizontalAlignment="Center"
                               TextAlignment="Center" MaxWidth="420" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button Content="粘贴一列姓名" Style="{StaticResource DeskPrimaryButton}" Click="OnPasteNames" />
                        <Button Content="从 Excel 导入" Style="{StaticResource DeskButton}" Click="OnImportExcel" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
