<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassPoints.App.Desk.DeskCountersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="事件计数" Style="{StaticResource DeskH1Text}" />
            <TextBlock x:Name="SubText" Style="{StaticResource DeskSecondaryText}" />
        </StackPanel>

        <!-- ===== 工具条 ===== -->
        <Grid Grid.Row="1" Margin="0,16,0,12" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox" PlaceholderText="搜索姓名 / 座位" Height="34"
                     TextChanged="OnSearchChanged" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <TextBlock x:Name="SummaryText" Style="{StaticResource DeskSecondaryText}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Content="新增事件" Style="{StaticResource DeskPrimaryButton}" Click="OnAddCounter" />
                <Button Content="管理事件" Style="{StaticResource DeskButton}" Click="OnManageCounters" />
                <Button Content="刷新" Style="{StaticResource DeskButton}" Click="OnRefresh" />
            </StackPanel>
        </Grid>

        <!-- ===== 表格 + 流水 ===== -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="296" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource DeskCardBorder}" Padding="0">
                <!--
                    事件类型是老师自己加的，列数不封顶。表格整体套一层横向滚动：
                    三列时正好铺满，加到第五第六列就横向滚，而不是把「合计」挤出卡片外面。
                -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto"
                              VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                    <Grid HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Background="{ThemeResource TileBgBrush}" CornerRadius="10,10,0,0" Padding="12,10">
                            <Grid x:Name="HeaderHost" ColumnSpacing="10" HorizontalAlignment="Left" />
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="RowList" HorizontalAlignment="Left" />
                        </ScrollViewer>

                        <StackPanel x:Name="EmptyPanel" Grid.Row="1" VerticalAlignment="Center"
                                    HorizontalAlignment="Center" Spacing="10" Visibility="Collapsed">
                            <TextBlock Text="还没有事件类型" Style="{StaticResource DeskH2Text}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="事件只数次数，不加减积分。比如迟到、作业未交。"
                                       Style="{StaticResource DeskSecondaryText}" HorizontalAlignment="Center"
                                       TextAlignment="Center" MaxWidth="420" />
                            <Button Content="新增一个事件" Style="{StaticResource DeskPrimaryButton}"
                                    HorizontalAlignment="Center" Click="OnAddCounter" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- 右侧流水：谁在什么时候被记了几次，改错了马上能看出来 -->
            <Border Grid.Column="1" Style="{StaticResource DeskCardBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Padding="16,14,16,8" Spacing="2">
                        <TextBlock Text="最近记录" Style="{StaticResource DeskH2Text}" />
                        <TextBlock Text="每按一次±都是一条，可核对" Style="{StaticResource DeskSecondaryText}" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,0,10">
                        <StackPanel x:Name="RecentList" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
