<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassPoints.App.Desk.DeskPeriodsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ClassPoints.App.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,28">
        <StackPanel Spacing="16">

            <StackPanel Spacing="4">
                <TextBlock Text="周期" Style="{StaticResource DeskH1Text}" />
                <TextBlock Text="重置不删数据，只换一个当前周期。"
                           Style="{StaticResource DeskSecondaryText}" />
            </StackPanel>

            <!-- ===== 当前周期 ===== -->
            <Border Style="{StaticResource DeskCardBorder}">
                <StackPanel Spacing="14">
                    <Grid>
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="PeriodNameText" Style="{StaticResource DeskH2Text}" />
                            <TextBlock x:Name="PeriodRangeText" Style="{StaticResource DeskSecondaryText}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Content="改个名字" Style="{StaticResource DeskButton}" Click="OnRename" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock x:Name="EntryCountText" FontFamily="{StaticResource NumberFont}"
                                       FontSize="26" FontWeight="SemiBold" />
                            <TextBlock Text="本期记录条数" Style="{StaticResource DeskSecondaryText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Name="PointsText" FontFamily="{StaticResource NumberFont}"
                                       FontSize="26" FontWeight="SemiBold" />
                            <TextBlock Text="本期净发放" Style="{StaticResource DeskSecondaryText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock x:Name="TermPointsText" FontFamily="{StaticResource NumberFont}"
                                       FontSize="26" FontWeight="SemiBold" />
                            <TextBlock Text="学期累计（总评口径）" Style="{StaticResource DeskSecondaryText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="2">
                            <TextBlock x:Name="TermKeyText" FontFamily="{StaticResource NumberFont}"
                                       FontSize="26" FontWeight="SemiBold" />
                            <TextBlock Text="学期编号" Style="{StaticResource DeskSecondaryText}" />
                        </StackPanel>
                    </Grid>

                    <Border Background="{ThemeResource CardBgBrush}" CornerRadius="8" Padding="14">
                        <TextBlock Style="{StaticResource DeskSecondaryText}"
                                   Text="本月积分按当前周期算，学期累计跨周期相加。两个数不一样，都对。" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== 两种重置 ===== -->
            <Border Style="{StaticResource DeskCardBorder}">
                <StackPanel Spacing="14">
                    <TextBlock Text="重置" Style="{StaticResource DeskH2Text}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{ThemeResource CardBgBrush}" CornerRadius="8"
                                BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="重置积分（学期编号不变）" Style="{StaticResource DeskBodyText}"
                                           FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource DeskSecondaryText}"
                                           Text="榜单清零重来。成绩、名单保留，总评仍按整学期。" />
                                <Button Content="重置积分…" Style="{StaticResource DeskButton}"
                                        HorizontalAlignment="Left" Click="OnResetPeriod" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{ThemeResource NegativeBgBrush}" CornerRadius="8"
                                BorderBrush="{ThemeResource NegativeBrush}" BorderThickness="1" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="重置学期（学期编号重开）" Style="{StaticResource DeskBodyText}"
                                           FontWeight="SemiBold" Foreground="{ThemeResource NegativeBrush}" />
                                <TextBlock Style="{StaticResource DeskSecondaryText}"
                                           Text="升年级、交接时用。全部归档，总评从零开始。" />
                                <controls:HoldButton x:Name="HardResetButton" HoldSeconds="3"
                                                     Label="长按 3 秒重置学期" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="ResetHint" Style="{StaticResource DeskSecondaryText}" />
                </StackPanel>
            </Border>

            <!-- ===== 历史周期 ===== -->
            <Border Style="{StaticResource DeskCardBorder}" Padding="0">
                <StackPanel>
                    <Grid Padding="18,14,18,12">
                        <TextBlock Text="历史周期" Style="{StaticResource DeskH2Text}" />
                        <TextBlock x:Name="ArchiveHint" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Style="{StaticResource DeskSecondaryText}" />
                    </Grid>

                    <Grid Padding="18,0,18,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="周期" Style="{StaticResource DeskColumnHeader}" />
                        <TextBlock Grid.Column="1" Text="时间范围" Style="{StaticResource DeskColumnHeader}" />
                        <TextBlock Grid.Column="2" Text="记录数" Style="{StaticResource DeskColumnHeader}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="总分" Style="{StaticResource DeskColumnHeader}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="操作" Style="{StaticResource DeskColumnHeader}" />
                    </Grid>

                    <StackPanel x:Name="ArchiveList" />
                    <StackPanel x:Name="ArchiveEmpty" Padding="18,16" Visibility="Collapsed">
                        <TextBlock Text="还没有归档周期。第一次重置后旧周期出现在这里。"
                                   Style="{StaticResource DeskSecondaryText}" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
