<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassPoints.App.Desk.DeskHomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,28">
        <StackPanel Spacing="16">

            <StackPanel Spacing="4">
                <TextBlock x:Name="TitleText" Text="总览" Style="{StaticResource DeskH1Text}" />
                <TextBlock x:Name="SubText" Style="{StaticResource DeskSecondaryText}" />
            </StackPanel>

            <!-- ===== 四个数字 ===== -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource DeskCardBorder}">
                    <StackPanel Spacing="2">
                        <!-- 颜色由代码按正负给：一直是绿色的"今日 −80"会和下面流水里红色的 −100 对不上 -->
                        <TextBlock x:Name="TodayPoints" Text="0" FontFamily="{StaticResource NumberFont}"
                                   FontSize="32" FontWeight="SemiBold" />
                        <TextBlock Text="今日发放积分" Style="{StaticResource DeskSecondaryText}" />
                        <TextBlock x:Name="TodayCount" Style="{StaticResource DeskSecondaryText}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource DeskCardBorder}">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="TermPoints" Text="0" FontFamily="{StaticResource NumberFont}"
                                   FontSize="32" FontWeight="SemiBold" />
                        <TextBlock Text="学期累计（总评口径）" Style="{StaticResource DeskSecondaryText}" />
                        <TextBlock x:Name="PeriodPoints" Style="{StaticResource DeskSecondaryText}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource DeskCardBorder}">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="StudentCount" Text="0" FontFamily="{StaticResource NumberFont}"
                                   FontSize="32" FontWeight="SemiBold" />
                        <TextBlock Text="在册学生" Style="{StaticResource DeskSecondaryText}" />
                        <TextBlock x:Name="SeatText" Style="{StaticResource DeskSecondaryText}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource DeskCardBorder}">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="ExamCount" Text="0" FontFamily="{StaticResource NumberFont}"
                                   FontSize="32" FontWeight="SemiBold" />
                        <TextBlock Text="本学期考试" Style="{StaticResource DeskSecondaryText}" />
                        <TextBlock x:Name="WeightText" Style="{StaticResource DeskSecondaryText}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <!-- ===== 最近记录 ===== -->
                <Border Grid.Column="0" Style="{StaticResource DeskCardBorder}" Padding="0">
                    <StackPanel>
                        <Grid Padding="18,14,18,10">
                            <TextBlock Text="最近记录" Style="{StaticResource DeskH2Text}" />
                            <TextBlock x:Name="RecentHint" HorizontalAlignment="Right"
                                       Style="{StaticResource DeskSecondaryText}" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel x:Name="RecentList" />
                        <Border Padding="18,10" x:Name="RecentEmpty" Visibility="Collapsed">
                            <TextBlock Text="还没有记录。名单就绪后到大屏刷卡记分。"
                                       Style="{StaticResource DeskSecondaryText}" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===== 待处理 ===== -->
                <Border Grid.Column="1" Style="{StaticResource DeskCardBorder}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="需要处理" Style="{StaticResource DeskH2Text}" />
                        <StackPanel x:Name="TodoList" Spacing="10" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== 快捷操作（终端里最常做的四件事） ===== -->
            <Border Style="{StaticResource DeskCardBorder}">
                <StackPanel Spacing="12">
                    <TextBlock Text="常用操作" Style="{StaticResource DeskH2Text}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="导入名单" Style="{StaticResource DeskButton}" Click="OnGoStudents" />
                        <Button Content="导入成绩" Style="{StaticResource DeskButton}" Click="OnGoExams" />
                        <Button Content="记事件" Style="{StaticResource DeskButton}" Click="OnGoCounters" />
                        <Button Content="立即备份" Style="{StaticResource DeskButton}" Click="OnBackup" />
                        <Button Content="打印排名表" Style="{StaticResource DeskButton}" Click="OnGoPrint" />
                        <Button Content="刷新" Style="{StaticResource DeskButton}" Click="OnRefresh" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
