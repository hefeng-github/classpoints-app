<?xml version="1.0" encoding="utf-8"?>
<!--
  色板：只有这 12 个值，多一个都不加（方案 9.10）。
  两套（浅色 / 深色）键名完全一致，靠根元素的 RequestedTheme 切换：

    浅色 = 默认。投影仪、教室日光灯、办公室白墙，浅底黑字的对比度最稳。
    深色 = 教室一体机夜里或不想让屏幕抢注意力时用，设置里可切。

  为什么不用 Mica 透壁纸：学校统一推的壁纸是蓝色风景图，
  一旦透出来界面就变蓝，对比度直接不可控。这里全部是不透明纯色。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- ==================== 浅色（默认） ==================== -->
        <ResourceDictionary x:Key="Light">
            <Color x:Key="BoardBgColor">#FFF4F6F9</Color>
            <Color x:Key="CardBgColor">#FFFFFFFF</Color>
            <Color x:Key="CardStrokeColor">#FFD9E0E9</Color>
            <Color x:Key="SelectStrokeColor">#FF0F6FC4</Color>
            <Color x:Key="TextPrimaryColor">#FF12161D</Color>
            <Color x:Key="TextSecondaryColor">#FF5B6675</Color>
            <Color x:Key="PositiveColor">#FF0B8A5F</Color>
            <Color x:Key="NegativeColor">#FFC62828</Color>
            <Color x:Key="PositiveBgColor">#FFE4F5EC</Color>
            <Color x:Key="NegativeBgColor">#FFFBEAEA</Color>
            <Color x:Key="WarnColor">#FFA5600A</Color>
            <Color x:Key="DangerColor">#FFC62828</Color>

            <SolidColorBrush x:Key="BoardBgBrush" Color="{StaticResource BoardBgColor}" />
            <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}" />
            <SolidColorBrush x:Key="CardStrokeBrush" Color="{StaticResource CardStrokeColor}" />
            <SolidColorBrush x:Key="SelectStrokeBrush" Color="{StaticResource SelectStrokeColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="PositiveBrush" Color="{StaticResource PositiveColor}" />
            <SolidColorBrush x:Key="NegativeBrush" Color="{StaticResource NegativeColor}" />
            <SolidColorBrush x:Key="PositiveBgBrush" Color="{StaticResource PositiveBgColor}" />
            <SolidColorBrush x:Key="NegativeBgBrush" Color="{StaticResource NegativeBgColor}" />
            <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

            <!-- 遮罩：浅色下用半透明深灰，压住底下的内容又不至于全黑 -->
            <SolidColorBrush x:Key="ScrimBrush" Color="#A6141A22" />

            <!-- 行分隔与轻量填充，浅色下需要比深色更淡 -->
            <SolidColorBrush x:Key="RowAltBrush" Color="#FFF7F9FC" />

            <SolidColorBrush x:Key="TileBgBrush" Color="#FFF1F4F8" />
            <SolidColorBrush x:Key="AccentBgBrush" Color="#FFE3F0FC" />
            <SolidColorBrush x:Key="StrokeStrongBrush" Color="#FFC3CDDA" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="FloatingBgBrush" Color="#FBFFFFFF" />
            <SolidColorBrush x:Key="AccentTintBrush" Color="#2E0F6FC4" />
        </ResourceDictionary>

        <!-- ==================== 深色 ==================== -->
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="BoardBgColor">#FF12161C</Color>
            <Color x:Key="CardBgColor">#FF1C222B</Color>
            <Color x:Key="CardStrokeColor">#FF2A3341</Color>
            <Color x:Key="SelectStrokeColor">#FF4CC2FF</Color>
            <Color x:Key="TextPrimaryColor">#FFF2F5F9</Color>
            <Color x:Key="TextSecondaryColor">#FF9AA7B8</Color>
            <Color x:Key="PositiveColor">#FF34D399</Color>
            <Color x:Key="NegativeColor">#FFF87171</Color>
            <Color x:Key="PositiveBgColor">#FF16352B</Color>
            <Color x:Key="NegativeBgColor">#FF3A1D14</Color>
            <Color x:Key="WarnColor">#FFFBBF24</Color>
            <Color x:Key="DangerColor">#FFEF4444</Color>

            <SolidColorBrush x:Key="BoardBgBrush" Color="{StaticResource BoardBgColor}" />
            <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}" />
            <SolidColorBrush x:Key="CardStrokeBrush" Color="{StaticResource CardStrokeColor}" />
            <SolidColorBrush x:Key="SelectStrokeBrush" Color="{StaticResource SelectStrokeColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="PositiveBrush" Color="{StaticResource PositiveColor}" />
            <SolidColorBrush x:Key="NegativeBrush" Color="{StaticResource NegativeColor}" />
            <SolidColorBrush x:Key="PositiveBgBrush" Color="{StaticResource PositiveBgColor}" />
            <SolidColorBrush x:Key="NegativeBgBrush" Color="{StaticResource NegativeBgColor}" />
            <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

            <SolidColorBrush x:Key="ScrimBrush" Color="#CC0B0E13" />
            <SolidColorBrush x:Key="RowAltBrush" Color="#FF171C24" />

            <SolidColorBrush x:Key="TileBgBrush" Color="#FF242C37" />
            <SolidColorBrush x:Key="AccentBgBrush" Color="#FF1D3B52" />
            <SolidColorBrush x:Key="StrokeStrongBrush" Color="#FF3A4350" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#FF0B1016" />
            <SolidColorBrush x:Key="FloatingBgBrush" Color="#F21C222B" />
            <SolidColorBrush x:Key="AccentTintBrush" Color="#334CC2FF" />
        </ResourceDictionary>

        <!-- 主题判不出来时（罕见）走浅色，和默认一致 -->
        <ResourceDictionary x:Key="Default">
            <Color x:Key="BoardBgColor">#FFF4F6F9</Color>
            <Color x:Key="CardBgColor">#FFFFFFFF</Color>
            <Color x:Key="CardStrokeColor">#FFD9E0E9</Color>
            <Color x:Key="SelectStrokeColor">#FF0F6FC4</Color>
            <Color x:Key="TextPrimaryColor">#FF12161D</Color>
            <Color x:Key="TextSecondaryColor">#FF5B6675</Color>
            <Color x:Key="PositiveColor">#FF0B8A5F</Color>
            <Color x:Key="NegativeColor">#FFC62828</Color>
            <Color x:Key="PositiveBgColor">#FFE4F5EC</Color>
            <Color x:Key="NegativeBgColor">#FFFBEAEA</Color>
            <Color x:Key="WarnColor">#FFA5600A</Color>
            <Color x:Key="DangerColor">#FFC62828</Color>

            <SolidColorBrush x:Key="BoardBgBrush" Color="{StaticResource BoardBgColor}" />
            <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}" />
            <SolidColorBrush x:Key="CardStrokeBrush" Color="{StaticResource CardStrokeColor}" />
            <SolidColorBrush x:Key="SelectStrokeBrush" Color="{StaticResource SelectStrokeColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="PositiveBrush" Color="{StaticResource PositiveColor}" />
            <SolidColorBrush x:Key="NegativeBrush" Color="{StaticResource NegativeColor}" />
            <SolidColorBrush x:Key="PositiveBgBrush" Color="{StaticResource PositiveBgColor}" />
            <SolidColorBrush x:Key="NegativeBgBrush" Color="{StaticResource NegativeBgColor}" />
            <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

            <SolidColorBrush x:Key="ScrimBrush" Color="#A6141A22" />
            <SolidColorBrush x:Key="RowAltBrush" Color="#FFF7F9FC" />

            <SolidColorBrush x:Key="TileBgBrush" Color="#FFF1F4F8" />
            <SolidColorBrush x:Key="AccentBgBrush" Color="#FFE3F0FC" />
            <SolidColorBrush x:Key="StrokeStrongBrush" Color="#FFC3CDDA" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="FloatingBgBrush" Color="#FBFFFFFF" />
            <SolidColorBrush x:Key="AccentTintBrush" Color="#2E0F6FC4" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- 字体不属于主题，放在主题字典外面 -->
    <!-- 分数用等宽（Consolas 全 Windows 自带且数字等宽）。
         比例数字在 48 张卡同时变分时会让整块网格左右抖。 -->
    <FontFamily x:Key="NumberFont">Consolas</FontFamily>
    <FontFamily x:Key="TextFont">Microsoft YaHei UI</FontFamily>

</ResourceDictionary>
